# ---- 运行时数据（日志/限流计数，含用户反馈信息）----
logs/
*.jsonl
# 知识库分块文件是部署必需数据，例外放行（服务器 clone 后需要它）
!data/chunks.jsonl

# ---- 前端依赖与构建产物 ----
frontend/node_modules/
# 前端 dist 是部署必需（服务器无 Node.js 环境无法本地构建），例外放行
!frontend/dist/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- 密钥与本地配置（绝不入库）----
.env
.env.*
*.key
!id_ed25519.pub

# ---- 编辑器/系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
frontend/.npm-cache/
frontend/vite.config.ts.timestamp-*.mjs
